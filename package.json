{
  "name": "rpcraft",
  "version": "0.2.6",
  "description": "A platform-agnostic, type-safe RPC toolkit that crafts end-to-end types — a first-class API for command definitions, link composition, and streaming. Inspired by tRPC.",
  "keywords": [
    "api",
    "http",
    "jsonrpc",
    "rpc",
    "schema-validation",
    "typescript"
  ],
  "homepage": "https://github.com/skordyr/rpcraft#readme",
  "license": "MIT",
  "author": "skordyr <xyan.sk@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skordyr/rpcraft.git"
  },
  "files": [
    "dist",
    "*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./http-link": "./dist/http-link.mjs",
    "./log-link": "./dist/log-link.mjs",
    "./mock-link": "./dist/mock-link.mjs",
    "./rpc": "./dist/rpc.mjs",
    "./template": "./dist/template.mjs",
    "./validate-link": "./dist/validate-link.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "eventsource-parser": "^3.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0"
}
